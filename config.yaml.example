# Configuration for substack2md
# Pass this file with --config or set SUBSTACK2MD_CONFIG

# Base directory for storing markdown files
# Can be overridden with --base-dir flag or SUBSTACK2MD_BASE_DIR environment variable
base_dir: ~/Documents/substack-notes

# Custom publication name mappings
# Key: publication slug from URL (e.g., 'daveshap' from daveshap.substack.com)
# Value: relative directory under base_dir. Absolute paths and '..' are rejected.
publication_mappings:
  # Example mappings for common newsletters
  # sigsub: Signals_And_Subtractions
  # natesnewsletter: Nates_Notes
  # daveshap: David_Shapiro

  # Add your own mappings here
